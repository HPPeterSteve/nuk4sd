# ==============================================================================
# Nukfile — Exemplo Declarativo de Sandbox para o Nuk4sd
# ==============================================================================

# 1. Configuração Básica do Cofre e Execução
vault "demo-vault"
exec /usr/bin/node /app/server.js

# 2. Isolamento de Rede e Firewall (nftables)
net veth
nfilter "demo-jail"
allow-ip 192.168.1.50
allow-ip 10.0.0.1

# 3. Supervisor e UUID Dinâmico
uuid enable

read-only /usr/lib /etc/ssl
read-write /var/log/app
blacklist ~/.ssh ~/.gnupg /etc/shadow
private-tmp
ro-home


seccomp strict

# 6. Limites de Recursos (rlimits / cgroups)
max-mem 2G
max-procs 256
max-fds 4096

# 7. Modelo Base Reutilizável
include base/server
